# Local secrets (.env.example is tracked as the template)
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Local on-disk data stores written by the starter at runtime.
# data/cost_log.jsonl is tracked on purpose: it is the canonical cost log
# behind the Deliverable 8 evidence (96 entries, frozen 11 Nov 2026).
data/chroma/
data/phoenix/

# Runtime inbox: ignore files dropped into data/inbox/ during dry runs.
# data/inbox/failed/ is tracked on purpose: it holds the watcher's
# quarantined files and .error.txt diagnostics, which are Deliverable 4
# evidence and must ship with the submission.
data/inbox/*.json

# Operator runtime artifacts from `make harvest-evidence`
WRITEUP-draft.md
WRITEUP-evidence/

# OS-level
.DS_Store

# Local Claude state
.claude/

# Local binaries
bin/

# Editor, log and archive files (never part of the submission)
.vscode/
.idea/
*.log
*.zip
