# Copy to .env and fill in. .env is git-ignored; this template is tracked.

# --- App ---
APP_ENV=dev                # dev | test | prod
APP_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR

# --- OpenAI (required) ---
OPENAI_API_KEY=
# Leave empty for api.openai.com. Course (Vocareum) keys need:
# OPENAI_BASE_URL=https://openai.vocareum.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL_SIMPLE=gpt-4o-mini
OPENAI_MODEL_COMPLEX=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=            # only for Qdrant Cloud
QDRANT_COLLECTION=products
